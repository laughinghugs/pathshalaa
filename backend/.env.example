# Which LLM provider to use: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic (Claude) — used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI (GPT-4V) — used when LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# Google OAuth client ID (Google Cloud Console -> Credentials -> OAuth client
# ID -> Web application). Must match VITE_GOOGLE_CLIENT_ID in frontend/.env.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: restrict sign-in to one Google Workspace domain (e.g. "myschool.edu").
# Leave blank to allow any Google account to sign in.
GOOGLE_ALLOWED_DOMAIN=

# Signs the app's session tokens issued after Google verification.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
