# Google OAuth client ID (Google Cloud Console -> Credentials -> OAuth client
# ID -> Web application). Must match GOOGLE_CLIENT_ID in backend/.env.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional. Leave unset for local dev (Vite's proxy forwards /api to
# localhost:8000) or if frontend+backend share an origin in production.
# If the backend is on a different server/domain, set this to its full URL,
# e.g. https://api.example.com/api
VITE_API_BASE_URL=
